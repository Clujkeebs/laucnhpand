# Required — the password that gates the whole app.
APP_PASSWORD=

# Required — random string used to sign the session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Strongly recommended for mainnet. Public RPC endpoints are rate-limited and
# will fail partway through a launch. Get one from Helius, QuickNode or Triton.
NEXT_PUBLIC_MAINNET_RPC=
NEXT_PUBLIC_DEVNET_RPC=

# Optional — enables the naming assistant on the issuance form. Everything else,
# including the artwork generator, works without it.
ANTHROPIC_API_KEY=

# Optional — enables image + metadata upload to IPFS from the launch form.
# Without it you can still launch by pasting a metadata URI you host elsewhere.
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=
