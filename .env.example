# ─── Required ────────────────────────────────────────────────────────────────
# Without both of these the app serves a setup screen instead of logging in.

# The password that gets you in. Choose a long one.
APP_PASSWORD=

# Signs the session cookie. Generate, never reuse a password:
#   openssl rand -hex 32
AUTH_SECRET=


# ─── Assistant (optional) ────────────────────────────────────────────────────
# Set ONE. OpenRouter wins if both are present. Without either, the naming
# assistant, the studio agent and automation are disabled; everything else,
# including the artwork generator, works normally.

# OpenRouter fronts cheap and free models.
OPENROUTER_API_KEY=
# Which model. Default: anthropic/claude-3.5-haiku (cheap and reliable with
# tools). Free models are much weaker at the multi-step tool calling the studio
# agent depends on.
OPENROUTER_MODEL=

ANTHROPIC_API_KEY=


# ─── Network (strongly recommended before live use) ──────────────────────────
# Public Solana endpoints rate-limit hard and will fail partway through a
# launch. Both accept a comma-separated list and are tried in order.
#   https://rpc-a.example,https://rpc-b.example
NEXT_PUBLIC_MAINNET_RPC=
NEXT_PUBLIC_DEVNET_RPC=


# ─── Coin artwork (all optional) ─────────────────────────────────────────────
# With no key set, images are generated by a free keyless service. Setting one
# of these gets you faster, higher-quality results.
FAL_KEY=
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=


# ─── Uploads (optional) ──────────────────────────────────────────────────────
# Pins the token image and metadata JSON to IPFS. Without it you can still
# launch by pasting a metadata URI you host yourself.
PINATA_JWT=
# Defaults to https://gateway.pinata.cloud
NEXT_PUBLIC_PINATA_GATEWAY=
